  # macOS
  .DS_Store
  **/.DS_Store

  # Jupyter
  .ipynb_checkpoints/
  **/.ipynb_checkpoints/

  # Python
  __pycache__/
  *.py[cod]
  .pytest_cache/
  .mypy_cache/

  # Virtual environments
  .venv/
  venv/
  env/

  # Environment variables
  .env
  .env.*

  # Raw dataset
  data/raw/*
  !data/raw/.gitkeep

  # Generated caches and archived files
  artifacts/
  reports/archive/

  # Temporary files
  tmp/
  *.tmp


